    "_overrideSchema": {
        "$comment": "Field reference for agents editing this file.",
        "uniformScale": "number | null \u2014 explicit uniform scale factor to apply to the outer instance instead of the auto-computed height-based scale. null = use pipeline auto-scale to targetHeight (1.85 units).",
        "yOffset": "number \u2014 additional Y translation (world units) applied to the outer instance AFTER Box3 floor-snap. Positive = move up. Use to correct residual floating/sinking that Box3 alone cannot resolve.",
        "rotationY": "number \u2014 additional Y-axis rotation (radians) applied to the outer instance AFTER the pipeline's authored-forward correction. Use to fix characters that still face the wrong direction after the geometry-centroid forward pass. Positive = counter-clockwise when viewed from above.",
        "forwardAxisOverride": "'+X' | '-X' | '+Z' | '-Z' | null \u2014 hard-codes the authored forward axis for this character, bypassing the geometry-centroid heuristic entirely. Use when the centroid heuristic produces a wrong result for an unusual asset.",
        "expectedBounds": {
            "minHeight": "number \u2014 minimum acceptable measured height (world units) after scale. Pipeline emits a WARNING (not BLOCKED) if measured height < minHeight.",
            "maxHeight": "number \u2014 maximum acceptable measured height (world units) after scale. Pipeline emits a WARNING if measured height > maxHeight.",
            "maxWidth": "number \u2014 maximum acceptable X extent (world units) after scale.",
            "maxDepth": "number \u2014 maximum acceptable Z extent (world units) after scale."
        },
        "frustumCulled": "boolean \u2014 sets SkinnedMesh.frustumCulled for all meshes in this character. Should remain false during the diagnostic/recovery phase.",
        "blocked": "boolean \u2014 when true, the pipeline immediately returns BLOCKED for this character without attempting to load or normalize. Use to hard-disable a known-broken asset.",
        "blockReason": "string | null \u2014 human-readable reason shown in the BLOCKED diagnostic when blocked=true."
    }
}