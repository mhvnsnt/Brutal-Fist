# Optional: a public Google Drive file URL or direct .glb URL.
# The file must be shared as "Anyone with the link".
# No Google OAuth token or Drive API key is required.
VITE_PUBLIC_MODEL_URL="https://drive.google.com/file/d/YOUR_PUBLIC_FILE_ID/view"

# Optional Gemini integration. The fighting game itself does not require this.
GEMINI_API_KEY=""
