{
  "name": "brutal-fist",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "preview:vite": "tsx server.ts",
    "build:vite": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start:vite": "node dist/server.cjs",
    "clean": "rm -rf .next dist server.js",
    "psx:fighter": "node tools/psx/decimate-fighter.mjs BannonSource/assets/models/BANNON_rigged.glb public/models/bannon_psx.glb --tris=18000 --tex=256",
    "bannon:manifest": "node tools/bannon/build-character-manifest.mjs && node tools/bannon/build-animation-manifest.mjs",
    "bannon:verify": "node tools/bannon/verify-and-build-roster.mjs",
    "sources:audit": "node tools/integration/build-source-audit.mjs",
    "glb:normalize": "node scripts/normalize-glb.mjs",
    "glb:normalize:dry": "node scripts/normalize-glb.mjs --dry-run --verbose",
    "glb:scan": "node tools/diagnostics/scan-roster-glbs.mjs",
    "glb:scan:verbose": "node tools/diagnostics/scan-roster-glbs.mjs --verbose",
    "glb:scan:output": "node tools/diagnostics/scan-roster-glbs.mjs --output docs/GLB_MANIFEST.json"
  },
  "dependencies": {
    "@dhiwise/component-tagger": "latest",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.49.4",
    "@tailwindcss/vite": "^4.1.14",
    "@use-gesture/react": "^10.3.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "howler": "2.2.4",
    "lucide-react": "^0.546.0",
    "meshoptimizer": "^0.24.0",
    "motion": "^12.23.24",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "three": "0.182.0",
    "three-stdlib": "^2.36.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/express": "^4.17.21",
    "@types/howler": "2.2.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
